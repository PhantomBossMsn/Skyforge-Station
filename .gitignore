# Unity .gitignore
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/SkyforgeStationWEB/

# Asset meta data should only be ignored when using the Apple double file system
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to only check in source code and not present assets
# /[Aa]ssets/*

# Autogenerated Visual Studio / Rider / VSCode project files
.vs/
.idea/
.vscode/
*.pidb
*.suo
*.user
*.userprefs
*.unityproj
*.sln
*.csproj
*.sublime-project
*.sublime-workspace
.vsconfig

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary cache
*~
